# ============================================================
# Environment Variables — Social Media Page Automation Tool
# Pixzora Labs · Copy to .env.local (dev) or set via secrets (prod)
# NEVER commit .env or .env.local to version control
# ============================================================

# ── Application ────────────────────────────────────────────
NODE_ENV=development
APP_URL=https://your-domain.com

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://pxzuser:change_me_now@localhost:5432/pixzora_social
POSTGRES_DB=pixzora_social
POSTGRES_USER=pxzuser
POSTGRES_PASSWORD=change_me_now  # Change before first run

# ── Authentication (Better Auth) ───────────────────────────
BETTER_AUTH_SECRET=generate_a_64_char_random_string_here
BETTER_AUTH_URL=https://your-domain.com

# ── Encryption (AES-256-GCM for Page tokens) ───────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate_a_64_hex_char_key_here

# ── Internal webhook authentication ────────────────────────
# Used to authenticate n8n → backend callbacks
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=generate_another_64_hex_char_key

# ── n8n ────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=pxz_n8n_admin
N8N_BASIC_AUTH_PASSWORD=change_me_now
N8N_ENCRYPTION_KEY=generate_a_32_char_random_string
N8N_DB=n8n

# ── Text AI — Gemini (Class C: free but conditional) ───────
# [VERIFY] free tier limits at https://ai.google.dev/pricing
# WARNING: Free tier may use prompts to improve models
GEMINI_API_KEY=
TEXT_AI_PROVIDER=gemini
TEXT_AI_MODEL=gemini-1.5-flash

# ── Image AI — Cloudflare Workers AI (Class C) ─────────────
# [VERIFY] free tier limits at https://developers.cloudflare.com/workers-ai/
CF_WORKERS_AI_TOKEN=
CF_ACCOUNT_ID=
IMAGE_AI_PROVIDER=cloudflare-workers-ai
IMAGE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell

# ── Object Storage — Cloudflare R2 (Class B) ───────────────
# [VERIFY] 10 GB storage, 1M Class B ops/month free
R2_BUCKET_NAME=pixzora-social-assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# ── Notifications ──────────────────────────────────────────
# Handled in-app (via database records)

# ── Error tracking — Sentry (Class B) ──────────────────────
# [VERIFY] 5,000 events/month free
SENTRY_DSN=

# ── Scheduler health — Healthchecks.io (Class B) ───────────
# [VERIFY] 20 checks free
HEALTHCHECKS_URL=https://hc-ping.com/your-uuid-here

# ── Facebook App ───────────────────────────────────────────
# [VERIFY] Required permissions, App Review, Business Verification
# Never store user access tokens here — they are encrypted in the database
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v21.0

# ── Admin seed (first-run only) ────────────────────────────
# Admin password is forced to change on first sign-in
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrator
# Password hash is generated from this on first seed run, then this var is cleared
SEED_ADMIN_INITIAL_PASSWORD=Change_me_on_first_sign_in!

# ── Cost control ────────────────────────────────────────────
DAILY_GENERATION_CAP=50
MONTHLY_GENERATION_CAP=1000
MAX_CONCURRENT_GENERATIONS=3
MAX_RETRY_COUNT=3
RETRY_DELAY_MINUTES=5,15,60   # comma-separated delays for each retry
